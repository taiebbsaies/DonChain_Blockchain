# API DonChain (NestJS). Copier en .env puis adapter.
PORT=4000
NODE_ENV=development

# PostgreSQL (docker compose -f infra/docker-compose.yml up -d)
DATABASE_URL=postgres://donchain:donchain@127.0.0.1:5432/donchain

# Chaîne indexée : 31337 = anvil local, 84532 = Base Sepolia (adresses lues dans contracts/deployments)
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# Blocs d'attente avant indexation (protection contre les réorganisations). Défaut : 0 en local, 3 ailleurs.
CONFIRMATIONS=
INDEXER_ENABLED=true
INDEXER_POLL_MS=4000

# Site web autorisé (CORS) ; les messages SIWE doivent provenir de ces domaines
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Jetons d'accès : secret d'au moins 32 caractères OBLIGATOIRE en production (ex. openssl rand -hex 32)
JWT_SECRET=
JWT_TTL_SECONDS=900

# IPFS. Sans PINATA_JWT, mode local : fichiers gardés en base et servis par /ipfs/:cid
PINATA_JWT=
# Épinglage secondaire (IPFS Pinning Service API), ex. Filebase : https://api.filebase.io/v1/ipfs
SECONDARY_PIN_URL=
SECONDARY_PIN_TOKEN=
# Passerelle renvoyée au client après téléversement
PUBLIC_IPFS_GATEWAY=http://localhost:4000
UPLOAD_MAX_BYTES=10485760
