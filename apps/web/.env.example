# Réseau ciblé : 31337 = anvil local, 84532 = Base Sepolia
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
# RPC Base Sepolia (facultatif : un RPC public est utilisé sinon)
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Portefeuilles mobiles (WalletConnect / Reown) : identifiant gratuit sur https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Adresse publique du site (affichée dans le portefeuille mobile)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API DonChain (Phase 2) : téléversements IPFS, explorateur, exports. Vide = lecture directe de la chaîne seulement.
NEXT_PUBLIC_API_URL=
# Passerelle IPFS. En local avec l'API sans Pinata : http://localhost:4000
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io

# Développement : hôtes supplémentaires autorisés à joindre le serveur de dev (séparés par des virgules)
NEXT_DEV_ORIGINS=
